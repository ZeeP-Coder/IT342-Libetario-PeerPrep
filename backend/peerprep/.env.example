# Copy this file to .env.local and fill in your values.
# Do not commit .env.local.

DB_URL=jdbc:postgresql://aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres?sslmode=require
DB_USERNAME=postgres.popjasyblcoejvdianri
DB_PASSWORD=YOUR_SUPABASE_DB_PASSWORD

FRONTEND_URL=http://localhost:5173

# Used by mobile Google token login (/api/auth/google)
GOOGLE_ANDROID_CLIENT_ID=YOUR_ANDROID_CLIENT_ID.apps.googleusercontent.com

# Used by web Google OAuth login (/api/auth/google -> /oauth2/authorization/google)
GOOGLE_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_WEB_CLIENT_SECRET
